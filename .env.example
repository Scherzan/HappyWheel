# Copy to .env.local for local dev. Values come from the happywheel-backend
# Terraform outputs (terraform output in stacks/happywheel-backend).
# In CI these are provided as GitHub Actions secrets (see .github/workflows/deploy.yml).
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-central-1.amazonaws.com
VITE_AWS_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
